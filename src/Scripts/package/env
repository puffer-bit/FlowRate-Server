# Public IP clients reach the SFU at; install.sh detects it and asks on the first run
PUBLIC_IP=
# Where the control panel (port 7114) listens. It has no authentication, so it stays on localhost:
# reach it through ssh -L 7114:127.0.0.1:7114, or set the LAN address of this machine
PANEL_LISTEN_IP=127.0.0.1
# Push notifications stay off while both are empty. Either the name of the Firebase service account
# key put in secrets/ next to this file (sends to FCM directly), or the URL of a push relay
PUSH_SERVICE_ACCOUNT_FILE=
PUSH_RELAY_URL=
# Passkey (FIDO2) logins stay off while it is empty. The domain users reach this server by, without scheme or port
# (chat.example.com). Changing it later invalidates every registered passkey. Passkeys are added in the control
# panel, which has to be opened at https://<this domain>:7114 for that (through an ssh tunnel: point the domain
# at 127.0.0.1 in the hosts file of your computer)
PASSKEY_DOMAIN=
