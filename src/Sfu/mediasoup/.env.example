# gRPC API used by the server (keep it inside the private network)
GRPC_BIND=127.0.0.1:50051

# WebRTC: one UDP+TCP port per announced address, shared by all media
RTC_LISTEN_IP=127.0.0.1
# Addresses clients connect to, comma separated, the first one is the primary.
# Entry: ip[:port][@listen-ip]; the port defaults to RTC_PORT, the listen address to RTC_LISTEN_IP.
# Entries bound to the same listen address need different ports, e.g. public and LAN:
#   RTC_ANNOUNCED_IPS=203.0.113.10,192.168.1.10:4434
# Required when RTC_LISTEN_IP is 0.0.0.0
RTC_ANNOUNCED_IPS=
RTC_PORT=4433

# debug | warn | error | none
MEDIASOUP_LOG_LEVEL=error
